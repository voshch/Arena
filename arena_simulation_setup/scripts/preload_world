#! /usr/bin/env python
"""Preload all assets referenced by a world via the standard arena_models resolvers.

Resolves every identifier that the world description and its scenarios reference.
The normal resolver chain (world-local → shared local → network provider) downloads
any missing assets to disk under ``ARENA_ASSETS_DIR/<provider>``.
"""
from __future__ import annotations

import argparse
import asyncio
import sys
import traceback
from pathlib import Path

from arena_simulation_setup.tree import DynamicPaths, Identifier, Verdict
from arena_simulation_setup.tree.World import MultiLevelWorldView, WorldIdentifier


async def _resolve_all(identifiers: list[Identifier]) -> tuple[int, int]:
    if not identifiers:
        return 0, 0

    total = len(identifiers)
    width = len(str(total))

    async def _resolve_one(ident: Identifier) -> tuple[Identifier, Path | BaseException]:
        try:
            return ident, await ident.resolve_path()
        except BaseException as exc:
            return ident, exc

    n_done = 0
    n_ok = 0
    for coro in asyncio.as_completed([_resolve_one(ident) for ident in identifiers]):
        ident, result = await coro
        n_done += 1
        if isinstance(result, BaseException):
            print(f'[{n_done:>{width}d}/{total}] MISS {ident.shortname}: {result}', flush=True)
        else:
            print(f'[{n_done:>{width}d}/{total}] OK   {ident.shortname} -> {result}', flush=True)
            n_ok += 1
    return n_ok, total


async def _probe_all(identifiers: list[Identifier]) -> tuple[int, int]:
    total = len(identifiers)
    width = len(str(total))
    n_ok = 0
    for n_done, ident in enumerate(identifiers, start=1):
        hit = next((v for v in await ident.probe() if v.verdict is Verdict.HIT), None)
        if hit is None:
            print(f'[{n_done:>{width}d}/{total}] MISS {ident.shortname}', flush=True)
        else:
            print(f'[{n_done:>{width}d}/{total}] OK   {ident.shortname} -> {hit.path}', flush=True)
            n_ok += 1
    return n_ok, total


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('world_name', help='Name of the world to preload.')
    parser.add_argument('--no-scenarios', action='store_true', help='Skip scenario assets.')
    parser.add_argument('--dry-run', action='store_true', help='Report what is missing without downloading.')
    args = parser.parse_args()

    try:
        world: MultiLevelWorldView = WorldIdentifier(args.world_name).resolve_sync()
    except FileNotFoundError as exc:
        print(exc, file=sys.stderr)
        return 1

    DynamicPaths.WORLD.path = world.path

    try:
        identifiers = list(world.identifiers(scenarios=not args.no_scenarios))
    except Exception:
        print(f'failed to load {world.path}:', file=sys.stderr)
        traceback.print_exc()
        return 1

    print(f'world {args.world_name}: {len(identifiers)} unique asset(s)')

    n_ok, n_total = asyncio.run(_probe_all(identifiers) if args.dry_run else _resolve_all(identifiers))
    print(f'resolved {n_ok}/{n_total}')
    return 0 if n_ok == n_total else 1


if __name__ == '__main__':
    raise SystemExit(main())
