repositories:
  # build deps
  deps/pcl_msgs:
    type: git
    url: https://github.com/ros-perception/pcl_msgs.git
    version: ros2
  deps/actuator_msgs:
    type: git
    url: https://github.com/rudislabs/actuator_msgs.git
  deps/gps_umd:
    type: git
    url: https://github.com/swri-robotics/gps_umd.git
    version: ros2-devel
  deps/vision_msgs:
    type: git
    url: https://github.com/ros-perception/vision_msgs.git
    version: jazzy
  deps/vision_opencv:
    type: git
    url: https://github.com/ros-perception/vision_opencv.git
    version: humble

  # internal python toolchains
  deps/ament_cmake_venv:
    type: git
    url: https://github.com/voshch/ament_cmake_venv
    version: humble
  deps/ament_cmake_venv_uv:
    type: git
    url: https://github.com/voshch/ament_cmake_venv_uv
    version: jazzy

  # internal management
  deps/arena_models:
    type: git
    url: https://github.com/voshch/arena-models
    version: master@d4d8a13

  # AAAAAAAA WHY IS #118 NOT VENDORED
  deps/topic_based_hardware_interfaces:
    type: git
    url: https://github.com/voshch/topic_based_hardware_interfaces
    version: main

  # upstream PR #28 (slider int() cast) stranded on rolling, never backported
  deps/rqt_robot_steering:
    type: git
    url: https://github.com/voshch/rqt_robot_steering
    version: jazzy

  # deps/xacro:
  #   type: git
  #   url: https://github.com/ros/xacro.git
  #   version: ros2

  # deps/nav2/navigation2:
  # type: git
  # url: https://github.com/voshch/navigation2.git
  # version: jazzy
  # deps/nav2/bond_core:
  # type: git
  # url: https://github.com/ros/bond_core.git
  # version: ros2
  # deps/nav2/BehaviorTree.CPP:
  # type: git
  # url: https://github.com/BehaviorTree/BehaviorTree.CPP.git
  # version: v3.8
  # deps/nav2/diagnostics:
  # type: git
  # url: https://github.com/ros/diagnostics.git
  # version: ros2
  # deps/nav2/angles:
  # type: git
  # url: https://github.com/ros/angles.git
  # version: ros2

  deps/nav2/nav2_mask_overlay_layer:
    type: git
    url: https://github.com/voshch/nav2_mask_overlay_layer
    version: jazzy
  
  deps/slam_toolbox:
    type: git
    url: https://github.com/SteveMacenski/slam_toolbox.git
    version: jazzy

  deps/hunav/hunav_sim:
    type: git
    url: https://github.com/voshch/hunav_sim.git
    version: jazzy
  deps/hunav/people_msgs:
    type: git
    url: https://github.com/wg-perception/people.git
    version: ros2
  deps/hunav/arena_hunav_sim_bridge:
    type: git
    url: https://github.com/ductaingn/arena_hunav_sim_bridge.git
    version: humble
  deps/arena_text_crowd:
    type: git
    url: https://github.com/ductaingn/arena_text_crowd.git

  # hri_rviz has no jazzy buildfarm binary, vendored + forked
  deps/hri/libhri:
    type: git
    url: https://github.com/voshch/libhri.git
    version: jazzy
  deps/hri/hri_rviz:
    type: git
    url: https://github.com/voshch/hri_rviz.git
    version: jazzy
  # human_description forked for the 24-dof skeleton contract (3-dof waist + articulated ankles)
  deps/human_description:
    type: git
    url: https://github.com/voshch/human_description.git
    version: arena-v2

  # generic runtime declarative display control for rviz2 (msgs + plugin)
  deps/rviz_display_control:
    type: git
    url: https://github.com/voshch/rviz_display_control.git
    version: jazzy

  # generic viewport/camera control for rviz2 + shared viewport_control_msgs
  deps/rviz_viewport_control:
    type: git
    url: https://github.com/voshch/rviz_viewport_control.git
    version: jazzy
