#!/usr/bin/env bash

ARENA_PROJECT_NAME="arena-$(basename "${HOST_ARENA_WS_DIR:-$ARENA_WS_DIR}")"
export ARENA_PROJECT_NAME
export ARENA_IMAGE_TAG="$ARENA_PROJECT_NAME"
export ARENA_IMAGE="arena:${ARENA_IMAGE_TAG}"

arena_docker_compose(){
    local files="$ARENA_DIR/_meta/docker/docker-compose.yaml"
    if [ -f "$ARENA_DIR/.installed" ]; then
        local feature ov
        while read -r feature; do
            ov="$ARENA_DIR/_meta/docker/features/${feature}/docker-compose.yml"
            [ -f "$ov" ] && files="${files}:${ov}"
        done < "$ARENA_DIR/.installed"
    fi
    ${arena_compose_sudo} env \
        ARENA_PROJECT_NAME="$ARENA_PROJECT_NAME" \
        ARENA_IMAGE="$ARENA_IMAGE" \
        ARENA_IMAGE_TAG="$ARENA_IMAGE_TAG" \
        ARENA_WS_DIR="$ARENA_WS_DIR" \
        ARENA_ROS_DISTRO="$ARENA_ROS_DISTRO" \
        HOST_UID="$HOST_UID" \
        HOST_GID="$HOST_GID" \
        HOST_ARENA_WS_DIR="$HOST_ARENA_WS_DIR" \
        HOST_ARENA_DATA_DIR="$HOST_ARENA_DATA_DIR" \
        ARENA_DATA_DIR="$ARENA_DATA_DIR" \
        ROSNAV_AGENTS_DIR="$ROSNAV_AGENTS_DIR" \
        ROS_DOMAIN_ID="${ROS_DOMAIN_ID:-1}" \
        COMPOSE_FILE="$files" \
        docker compose \
        --project-directory "$ARENA_WS_DIR" \
        --project-name "$ARENA_PROJECT_NAME" \
        "$@"
}
[ -n "${BASH_VERSION:-}" ] && export -f arena_docker_compose || true
