#!/usr/bin/env bash

arena_docker(){
    ${arena_compose_sudo} docker "$@"
}

arena_podman(){
    { docker --version; arena_docker version --format '{{range .Server.Components}}{{.Name}} {{end}}'; } 2>/dev/null | grep -qi podman
}

ARENA_PROJECT_NAME="arena-$(basename "${HOST_ARENA_WS_DIR:-$ARENA_WS_DIR}")"
export ARENA_PROJECT_NAME
export ARENA_IMAGE_TAG="$ARENA_PROJECT_NAME"
export ARENA_IMAGE="arena:${ARENA_IMAGE_TAG}"
arena_podman && export ARENA_IMAGE="localhost/$ARENA_IMAGE"

export ARENA_ENV_FILE="${ARENA_WS_DIR:-$HOST_ARENA_WS_DIR}/.env"

[ -n "${ARENA_GPU+x}" ] && export ARENA_GPU

# prints "<value>\t<source>\t<on|off|invalid>", exits 0 when passthrough is on
arena_gpu(){
    local raw source state
    raw=$(sed -n 's/^[[:space:]]*ARENA_GPU=//p' "$ARENA_ENV_FILE" 2>/dev/null | tail -n1)
    if [ -n "$raw" ]; then
        source=$ARENA_ENV_FILE
    elif [ -n "${ARENA_GPU+x}" ]; then
        raw=$ARENA_GPU
        source=environment
    else
        source=unset
    fi
    raw=${raw%%[[:space:]]#*}
    raw=${raw//[\"\'[:space:]$'\r']/}
    case "$raw" in
        1|true|yes|on) state=on ;;
        ''|0|false|no|off) state=off ;;
        *) state=invalid ;;
    esac
    printf '%s\t%s\t%s\n' "$raw" "$source" "$state"
    [ "$state" = on ]
}

# ${ARENA_WS_DIR} client-side, $HOST_ARENA_WS_DIR for volume sources
_arena_compose_file(){
    local f
    for f in "$1" ${podman:+"${1%.yaml}.podman.yaml"}; do
        [ -f "$f" ] || continue
        files="${files:+$files:}$f"
    done
}

arena_docker_compose(){
    local podman files feature
    arena_podman && podman=1
    _arena_compose_file "$ARENA_DIR/_meta/docker/docker-compose.yaml"
    [ -d /dev/dri ] && _arena_compose_file "$ARENA_DIR/_meta/docker/docker-compose.dri.yaml"
    arena_gpu > /dev/null && _arena_compose_file "$ARENA_DIR/_meta/docker/docker-compose.gpu.yaml"
    if [ -f "$ARENA_DIR/.installed" ]; then
        while read -r feature; do
            _arena_compose_file "$ARENA_DIR/_meta/docker/features/$feature/docker-compose.yaml"
        done < "$ARENA_DIR/.installed"
    fi
    ${arena_compose_sudo} env ${podman:+DOCKER_BUILDKIT=0} ${podman:+COMPOSE_BAKE=false} ROS_DOMAIN_ID="${ROS_DOMAIN_ID:-1}" COMPOSE_FILE="$files" \
        docker compose \
        --env-file "$ARENA_ENV_FILE" \
        --project-name "$ARENA_PROJECT_NAME" \
        "$@"
}
# compose 5 builds only via buildx, which podman lacks: build from the resolved config with the engine's plain build path
arena_compose_build(){
    if ! arena_podman; then
        arena_docker_compose build "$@"
        return
    fi
    local py lines line
    py=$(cat <<'EOF'
import json, os, shlex, sys
cfg = json.load(sys.stdin)
for name in sys.argv[1:]:
    b = cfg["services"][name].get("build")
    if not b:
        continue
    if b.get("additional_contexts") or b.get("secrets"):
        sys.exit(f"arena: build of '{name}' needs buildkit, unsupported under podman")
    # compose resolves unqualified image names to docker.io/library
    image = cfg["services"][name]["image"]
    first = image.split("/", 1)[0]
    if "/" not in image:
        image = "docker.io/library/" + image
    elif "." not in first and ":" not in first and first != "localhost":
        image = "docker.io/" + image
    argv = ["-t", image, "-f", os.path.join(b["context"], b.get("dockerfile", "Dockerfile"))]
    for k, v in (b.get("args") or {}).items():
        if v is not None:
            argv += ["--build-arg", f"{k}={v}"]
    if b.get("target"):
        argv += ["--target", b["target"]]
    print(shlex.join(argv + [b["context"]]))
EOF
)
    lines=$(arena_docker_compose config --format json | python3 -c "$py" "$@") || return 1
    while IFS= read -r line; do
        [ -n "$line" ] || continue
        eval "set -- $line"
        DOCKER_BUILDKIT=0 arena_docker build "$@" || return 1
    done <<< "$lines"
}
arena_containers(){
    local status="--filter=status=running"
    if [ "$1" = -a ]; then
        status=""
        shift
    fi
    arena_docker ps -a -q $status \
        --filter "label=com.docker.compose.project=$ARENA_PROJECT_NAME" \
        --filter "label=com.docker.compose.service=$1"
}

arena_container_state(){
    arena_docker inspect -f '{{if .State.Health}}{{with .State.Health.Status}}{{.}}{{else}}none{{end}}{{else}}none{{end}} {{.State.Status}}' "$1"
}

arena_container_health(){
    local id
    id=$(arena_containers "$1" | head -n1)
    [ -n "$id" ] || return 1
    arena_container_state "$id" | cut -d" " -f1
}

arena_container_wait(){
    local svc id health run
    for svc in "$@"; do
        while true; do
            id=$(arena_containers -a "$svc" | head -n1)
            if [ -z "$id" ]; then
                sleep 1
                continue
            fi
            read -r health run <<< "$(arena_container_state "$id" 2>/dev/null)"
            if [ "$run" = running ] && { [ "$health" = healthy ] || [ "$health" = none ]; }; then
                break
            fi
            case "$run" in
                running|restarting|created|"") sleep 1 ;;
                *) return 1 ;;
            esac
        done
    done
}

arena_container_rm(){
    arena_containers -a "$1" | xargs -r ${arena_compose_sudo} docker rm -f
}
export -f _arena_compose_file arena_docker_compose arena_compose_build arena_gpu arena_podman arena_docker arena_containers arena_container_state arena_container_health arena_container_wait arena_container_rm 2>/dev/null || true

arena_podman_env(){
    arena_podman || return 0
    local info sock rootless mode ctl
    info=$(podman info --format '{{.Host.RemoteSocket.Path}} {{.Host.Security.Rootless}}') || return 1
    read -r sock rootless <<< "$info"
    sock=${sock#unix://}
    if ! podman --remote --url "unix://$sock" version >/dev/null 2>&1; then
        if [ -d "$sock" ]; then
            echo "arena: $sock is a directory left behind by a container started without the socket, rmdir it first" >&2
        fi
        [ "$rootless" = true ] && ctl="systemctl --user" || ctl="sudo systemctl"
        echo "arena: podman API socket $sock is not running, run: $ctl enable --now podman.socket" >&2
        return 1
    fi
    mode=host
    [ "$rootless" = true ] && mode=keep-id
    grep -q '^ARENA_DOCKER_SOCK=' "$ARENA_ENV_FILE" || echo "ARENA_DOCKER_SOCK=$sock" >> "$ARENA_ENV_FILE"
    grep -q '^ARENA_USERNS_MODE=' "$ARENA_ENV_FILE" || echo "ARENA_USERNS_MODE=$mode" >> "$ARENA_ENV_FILE"
}
