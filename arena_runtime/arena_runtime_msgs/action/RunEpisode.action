# World; empty inherits.
string world
# Seed override; -1 derives.
int64 seed -1
---
uint8 QUEUED  = 0
uint8 RUNNING = 1
uint8 SUCCESS = 2
uint8 FAILED  = 3
uint8 SKIPPED = 4
# env never reached a runnable state; do not retry
uint8 FATAL   = 5
uint8 state
string info
uint32 episode_id
---
uint8 STARTED = 1
uint8 state
