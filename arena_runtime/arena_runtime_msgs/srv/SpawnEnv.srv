# Programmatically launch an env owned by arena_runtime_node.
string ns                # explicit ns path (e.g. for sim2real); empty = auto-allocate
bool headless            # if true, only write subprocess output to log file; otherwise also echo to parent stdout
string[] launch_args     # passthrough to env.launch.py, "name:=value"
---
bool success
uint16 env_id
string ns
string log_path          # path to the env subprocess's log file
string error_msg
