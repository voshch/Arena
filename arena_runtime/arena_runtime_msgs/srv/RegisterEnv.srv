string caller_id          # taskgen FQN
uint16 env_id             # 65535 = auto-allocate, else pin to this id
string ns                 # explicit ns path, empty = auto-generate "arena/env_<id>/task_generator_node"
---
bool success
uint16 env_id             # allocated id (0..N-1), reused after eviction
string ns                 # final ns path
string sim                # arena's configured sim (dummy/gazebo/isaac), env should match
string error_msg
