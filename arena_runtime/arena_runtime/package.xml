<?xml version='1.0' encoding='utf-8'?>
<package format="3">
  <name>arena_runtime</name>
  <version>0.0.0</version>
  <description>Arena-Rosnav runtime: owns the `arena_node` lifecycle node and the per-simulator adapters.</description>
  <maintainer email="dev@voshch.dev">voshch</maintainer>
  <license>TODO</license>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>ros_gz_sim</depend>
  <depend>ros_gz_interfaces</depend>

  <exec_depend>arena_rclpy_mixins</exec_depend>
  <exec_depend>arena_robots</exec_depend>
  <exec_depend>controller_manager_msgs</exec_depend>
  <exec_depend>joint_state_topic_hardware_interface</exec_depend>
  <exec_depend>arena_simulation_setup</exec_depend>
  <exec_depend>arena_runtime_msgs</exec_depend>
  <exec_depend>rosgraph_msgs</exec_depend>
  <exec_depend>viewport_control_msgs</exec_depend>
  <exec_depend>arena_people_msgs</exec_depend>
  <exec_depend>isaacsim_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>python3-yaml</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
