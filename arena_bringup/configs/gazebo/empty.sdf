<?xml version="1.0"?>
<sdf version="1.9">
  <world name="default">
    <scene>
      <ambient>0.6 0.6 0.6 1</ambient>
      <background>0.7 0.7 0.8 1</background>
      <sky></sky>
      <shadows>false</shadows>
    </scene>

    <!-- GPS reference: Waterloo, ON (from former GAZEBO_WORLD_LAT/LON env defaults in hector plugin) -->
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>43.50076203</latitude_deg>
      <longitude_deg>-80.54629721</longitude_deg>
      <elevation>0</elevation>
      <heading_deg>0</heading_deg>
    </spherical_coordinates>

    <plugin
      filename="gz-sim-physics-system"
      name="gz::sim::systems::Physics">
    </plugin>
    <plugin
      filename="gz-sim-user-commands-system"
      name="gz::sim::systems::UserCommands">
    </plugin>
    <plugin
      filename="gz-sim-scene-broadcaster-system"
      name="gz::sim::systems::SceneBroadcaster">
    </plugin>
    <plugin
      filename="gz-sim-contact-system"
      name="gz::sim::systems::Contact">
    </plugin>
    <plugin filename="gz-sim-imu-system"
      name="gz::sim::systems::Imu">
    </plugin>
    <plugin
      filename="gz-sim-sensors-system"
      name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <physics name="physics" type="ignored">
      <max_step_size>0.0333</max_step_size> <!-- minimum 30 steps per second -->
      <real_time_update_rate>0</real_time_update_rate>
    </physics>

    <!-- Shadowless rig: four directional lights from each side, downward-biased, for even
         lighting with no cast shadows. ogre2 PBR is lit by these, not by scene ambient. -->
    <light type="directional" name="sun">
      <cast_shadows>false</cast_shadows>
      <diffuse>0.45 0.45 0.45 1</diffuse>
      <specular>0 0 0 1</specular>
      <direction>-1 0 -0.35</direction>
    </light>
    <light type="directional" name="fill_west">
      <cast_shadows>false</cast_shadows>
      <diffuse>0.45 0.45 0.45 1</diffuse>
      <specular>0 0 0 1</specular>
      <direction>1 0 -0.35</direction>
    </light>
    <light type="directional" name="fill_north">
      <cast_shadows>false</cast_shadows>
      <diffuse>0.45 0.45 0.45 1</diffuse>
      <specular>0 0 0 1</specular>
      <direction>0 -1 -0.35</direction>
    </light>
    <light type="directional" name="fill_south">
      <cast_shadows>false</cast_shadows>
      <diffuse>0.45 0.45 0.45 1</diffuse>
      <specular>0 0 0 1</specular>
      <direction>0 1 -0.35</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <pose>0 0 -1 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>1250 1250</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>1255 1255</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.8 0.8 0.8 1</specular>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>