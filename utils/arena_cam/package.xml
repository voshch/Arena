<?xml version='1.0' encoding='utf-8'?>
<package format="3">
  <name>arena_cam</name>
  <version>0.0.0</version>
  <description>Viewport-camera client for Arena: scripted shots over /arena/viewport/* and an rqt panel for keyboard flying.</description>
  <maintainer email="dev@voshch.dev">voshch</maintainer>
  <license>TODO</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>arena_rclpy_mixins</exec_depend>
  <exec_depend>arena_runtime_msgs</exec_depend>
  <exec_depend>viewport_control_msgs</exec_depend>
  <exec_depend>task_generator_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>rqt_gui</exec_depend>
  <exec_depend>rqt_gui_py</exec_depend>
  <exec_depend>python_qt_binding</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
    <rqt_gui plugin="${prefix}/plugin.xml"/>
  </export>
</package>
