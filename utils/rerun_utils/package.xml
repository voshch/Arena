<?xml version="1.0"?>
<package format="2">
  <name>rerun_utils</name>
  <version>0.0.0</version>
  <description>Rerun.io web-viewer bridge for the arena_viz contract.</description>

  <maintainer email="dev@voshch.dev">voshch</maintainer>

  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>arena_rclpy_mixins</depend>
  <depend>arena_viz</depend>
  <exec_depend>arena_mcp</exec_depend>
  <depend>arena_bringup</depend>
  <depend>arena_runtime_msgs</depend>
  <depend>arena_people_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>tf2_msgs</depend>
  <depend>visualization_msgs</depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
